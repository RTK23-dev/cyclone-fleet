{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclone.local/schemas/cyclone.ports/1/manifest.json",
  "title": "Cyclone plugin manifest (GET /cyclone-plugin.json)",
  "type": "object",
  "required": [
    "contract",
    "name",
    "version",
    "endpoint",
    "serves"
  ],
  "properties": {
    "contract": {
      "const": "cyclone.ports/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "endpoint": {
      "type": "string",
      "description": "Base URL. Plain http only on 127.0.0.1, localhost or [::1]; https anywhere else.",
      "pattern": "^(https://.+|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:\\d+)?/?)$"
    },
    "serves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "port",
          "way"
        ],
        "properties": {
          "port": {
            "anyOf": [
              {
                "enum": [
                  "run.event",
                  "screen.shot",
                  "account.fields",
                  "page.text",
                  "file.out",
                  "log.line",
                  "file.in",
                  "value.in",
                  "code.in",
                  "link.in"
                ]
              },
              {
                "type": "string",
                "pattern": "^x\\.[a-z][a-z0-9-]{1,40}\\.[a-z][a-z0-9-]{0,40}$",
                "description": "Extension port x.<this plugin's name>.<name>, always personal."
              }
            ]
          },
          "way": {
            "enum": [
              "out",
              "in"
            ]
          }
        }
      }
    },
    "needs": {
      "type": "object",
      "properties": {
        "personal": {
          "type": "boolean",
          "description": "Must be true when any served port is personal."
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional capabilities. Defined: idempotent-delivery. Reserved: pull, upload, mcp. Unknown names are ignored."
    }
  }
}
