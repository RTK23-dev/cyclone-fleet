{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyclone.human_gesture.trace.v1",
  "title": "Cyclone Human Gesture normalized trace v1",
  "type": "object",
  "required": [
    "schema",
    "gesture_type",
    "profile",
    "viewport",
    "duration_ms",
    "points"
  ],
  "properties": {
    "schema": {
      "const": "cyclone.human_gesture.trace.v1"
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "enum": ["procedural", "recorded", "replay", "synthetic_reference"]
    },
    "gesture_type": {
      "enum": ["tap", "swipe", "drag"]
    },
    "profile": {
      "enum": ["OFF", "LIGHT", "NORMAL"]
    },
    "seed": {
      "type": ["integer", "null"]
    },
    "viewport": {
      "type": "object",
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {"type": "number", "exclusiveMinimum": 0},
        "height_px": {"type": "number", "exclusiveMinimum": 0},
        "rotation_degrees": {"enum": [0, 90, 180, 270]}
      },
      "additionalProperties": false
    },
    "duration_ms": {"type": "number", "minimum": 0},
    "target": {
      "type": "object",
      "properties": {
        "bounds_norm": {
          "type": "object",
          "required": ["left", "top", "right", "bottom"],
          "properties": {
            "left": {"type": "number", "minimum": 0, "maximum": 1},
            "top": {"type": "number", "minimum": 0, "maximum": 1},
            "right": {"type": "number", "minimum": 0, "maximum": 1},
            "bottom": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "execution": {
      "description": "Optional bounded identity only; no secrets, UI text, or raw credentials.",
      "type": "object",
      "properties": {
        "sessionId": {"type": "string"},
        "displayId": {"type": "integer", "minimum": 0},
        "workspaceId": {"type": "string"},
        "workspaceGeneration": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["u", "v", "t"],
        "properties": {
          "u": {"type": "number", "minimum": 0, "maximum": 1},
          "v": {"type": "number", "minimum": 0, "maximum": 1},
          "t": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "synthesis": {
      "description": "Optional engine-reported synthesis diagnostics; clipped is authoritative only when the engine supplies it.",
      "type": "object",
      "properties": {
        "clipped": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
