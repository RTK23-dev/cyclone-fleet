# Copy to gateway.env (same folder) or let start-tunnel.ps1 generate it.
# gateway.env is gitignored. Never commit the live token.

# Required. 32+ random bytes, base64url. Rotate with scripts/rotate-token.ps1
GATEWAY_BEARER_TOKEN=replace-me

# Bind loopback only. cloudflared connects here; do not change host to 0.0.0.0.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Path CycloneAgentMCP.exe (stdio). Leave default unless you installed elsewhere.
# Prefer Cyclone One; legacy Companion is fallback only.
# MCP_COMMAND=%LOCALAPPDATA%\Cyclone One\CycloneAgentMCP.exe
# MCP_ARGS=serve

# readonly (default) = only observational tools. full = all tools, still requires bearer.
GATEWAY_MODE=readonly

# Comma-separated tool names used when GATEWAY_MODE=readonly.
# GATEWAY_ALLOWLIST=phone_status,phone_observe,phone_locate,phone_screenshot,phone_capabilities,phone_devices

# Idle MCP child sessions are killed after this many seconds (0 = never).
# GATEWAY_SESSION_IDLE_SEC=900

# Max concurrent HTTP MCP sessions (each spawns one CycloneAgentMCP.exe).
# GATEWAY_MAX_SESSIONS=8

# Public origin used for Origin checks and well-known metadata (optional).
# PUBLIC_URL=https://your-subdomain.trycloudflare.com
