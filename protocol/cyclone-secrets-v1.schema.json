{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclone.local/protocol/cyclone-secrets-v1.schema.json",
  "title": "Cyclone Secrets v1",
  "description": "Metadata and boolean presence only. Secret values never cross this contract.",
  "oneOf": [
    { "$ref": "#/$defs/slotPresence" },
    { "$ref": "#/$defs/secretRequest" },
    { "$ref": "#/$defs/secretRequestAck" }
  ],
  "$defs": {
    "persona": { "enum": ["live", "mapping"] },
    "placeId": {
      "type": "string",
      "minLength": 9,
      "maxLength": 512,
      "pattern": "^(package:[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+|chrome:https?://[^\\s/]+(?::[0-9]{1,5})?)$"
    },
    "slotName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$"
    },
    "slotPresence": {
      "type": "object",
      "required": ["placeId", "persona", "slots"],
      "properties": {
        "placeId": { "$ref": "#/$defs/placeId" },
        "persona": { "$ref": "#/$defs/persona" },
        "slots": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/slotName" },
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": false
    },
    "secretRequest": {
      "type": "object",
      "required": ["placeId", "persona", "slot", "reason"],
      "properties": {
        "placeId": { "$ref": "#/$defs/placeId" },
        "persona": { "$ref": "#/$defs/persona" },
        "slot": { "$ref": "#/$defs/slotName" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "additionalProperties": false
    },
    "secretRequestAck": {
      "type": "object",
      "required": ["state", "request"],
      "properties": {
        "state": { "const": "needs-secret" },
        "request": { "$ref": "#/$defs/secretRequest" }
      },
      "additionalProperties": false
    }
  }
}